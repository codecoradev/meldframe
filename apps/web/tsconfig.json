{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["svelte", "vite/client", "node"],
    "noEmit": true,
    "paths": { "vitest": ["./node_modules/vitest"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "dev/**/*.ts", "vite.config.ts", "../../packages/web-*/src/**/*.ts"]
}
