{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "types": ["svelte", "vite/client", "node"],
    "noEmit": true,
    "paths": { "vitest": ["./node_modules/vitest"], "@meldframe/web-canvas/*": ["../../packages/web-canvas/src/*"], "@meldframe/web-paint/*": ["../../packages/web-paint/src/*"], "@meldframe/web-input/*": ["../../packages/web-input/src/*"], "@meldframe/web-assets/*": ["../../packages/web-assets/src/*"], "@meldframe/web-link/*": ["../../packages/web-link/src/*"], "@meldframe/web-transport/*": ["../../packages/web-transport/src/*"], "@meldframe/web-document/*": ["../../packages/web-document/src/*"], "@meldframe/web-tokens/*": ["../../packages/web-tokens/src/*"], "@meldframe/web-chrome/*": ["../../packages/web-chrome/src/*"], "@meldframe/web-shell/*": ["../../packages/web-shell/src/*"], "bits-ui": ["./node_modules/bits-ui"], "@base-ui/react": ["./node_modules/@base-ui/react"], "@base-ui/react/*": ["./node_modules/@base-ui/react/*"], "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"], "react-dom": ["./node_modules/@types/react-dom"], "react-dom/*": ["./node_modules/@types/react-dom/*"], "@meldframe/web-panels/*": ["../../packages/web-panels/src/*"], "@meldframe/web-variables/*": ["../../packages/web-variables/src/*"], "@meldframe/web-variables-io/*": ["../../packages/web-variables-io/src/*"], "@meldframe/web-activity/*": ["../../packages/web-activity/src/*"], "@meldframe/web-feedback/*": ["../../packages/web-feedback/src/*"], "@meldframe/web-export/*": ["../../packages/web-export/src/*"], "@meldframe/protocol": ["../../packages/protocol/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.svelte", "vite.config.ts", "../../packages/web-*/src/**/*.ts", "../../packages/web-*/src/**/*.tsx", "../../packages/web-*/src/**/*.svelte"]
}
