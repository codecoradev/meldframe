# Copy to .env (git-ignored). Development values only.
MELDFRAME_ENV=development

# Postgres from `just dev-db` (docker compose, or scripts/pg-start.sh without Docker).
MELDFRAME_PG_PORT=5433
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/meldframe_dev
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/meldframe_test

# Server (arrives in E1.x).
MELDFRAME_LISTEN=127.0.0.1:8080

# Web dev shell (`just dev-web`): the Vite proxy adds this token to REST and the live socket, so the browser
# never holds it. The token must be one entry of MELDFRAME_DEV_TOKENS (token:workspace:actor) of the server.
MELDFRAME_WEB_TOKEN=
MELDFRAME_WEB_ACTOR=
MELDFRAME_WEB_FILE=file_dev
