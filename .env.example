# Copy to .env (git-ignored). Development values only.
MELDFRAME_ENV=development

# Postgres from `just dev-db` (docker compose, or scripts/pg-start.sh without Docker).
MELDFRAME_PG_PORT=5433
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/meldframe_dev
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/meldframe_test

# Server (`just dev`). With DATABASE_URL set it keeps files in Postgres, otherwise in memory.
# The dev token is generated into .dev-token by `just dev`; set MELDFRAME_DEV_TOKENS (token:workspace:actor,
# tokens of 16 bytes or more) only when running the binary by hand.
MELDFRAME_LISTEN=127.0.0.1:8080
# Reverse proxies whose X-Forwarded-For the server believes (comma-separated IP addresses); none by default.
# MELDFRAME_TRUSTED_PROXIES=127.0.0.1
